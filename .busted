-- busted config. Tests run on Lua 5.1 only (the game client's Lua); the fake world
-- in spec/support/wow.lua asserts it. Run from the repo root: `busted`, or
-- `busted --coverage` for luacov (settings in .luacov).
return {
    _all = {
        lpath = "./?.lua",
    },
    default = {
        ROOT = { "spec" },
        pattern = "_spec",
        verbose = true,
    },
}
